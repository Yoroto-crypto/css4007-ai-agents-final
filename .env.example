# Copy to .env (never commit .env) and fill in your values.
GEMINI_API_KEY=your-api-key-here

# Model names are configurable; check the Gemini API docs for current names.
GEMINI_MODEL_PLANNER=gemini-3.5-flash-lite
GEMINI_MODEL_FAST=gemini-3.1-flash-lite

# Agent execution limits (optional, defaults shown)
MAX_STEPS=10
MAX_TOOL_CALLS=20
MAX_RETRIES=2
MAX_TOKENS=20000
